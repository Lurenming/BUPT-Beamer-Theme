{
  "latex-workshop.latex.tools": [
    {
      "name": "bupt-xelatexmk",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "BUPT XeLaTeX",
      "tools": [
        "bupt-xelatexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "BUPT XeLaTeX"
}
